+"use strict";
+
+const { RNP } = ChromeUtils.importESModule(
+  "chrome://openpgp/content/modules/RNP.sys.mjs"
+);
+const { EnigmailConstants } = ChromeUtils.importESModule(
+  "chrome://openpgp/content/modules/constants.sys.mjs"
+);
+const { EnigmailKeyRing } = ChromeUtils.importESModule(
+  "chrome://openpgp/content/modules/keyRing.sys.mjs"
+);
+const { EnigmailKeyServer } = ChromeUtils.importESModule(
+  "chrome://openpgp/content/modules/keyserver.sys.mjs"
+);
+const { OpenPGPMasterpass } = ChromeUtils.importESModule(
+  "chrome://openpgp/content/modules/masterpass.sys.mjs"
+);
+const { OpenPGPTestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/mail/OpenPGPTestUtils.sys.mjs"
+);
+
+const pqcDataDir =
+  "../../../../../../third_party/rnp/src/tests/data/draft-ietf-openpgp-pqc";
+const data = "Testing\n";
+
+const vectors = [
+  {
+    name: "ML-DSA-65",
+    publicKey: "v6-mldsa-65-sample-pk.asc",
+    signature: "v6-mldsa-65-sample-signature.asc",
+  },
+  {
+    name: "ML-DSA-87",
+    publicKey: "v6-mldsa-87-sample-pk.asc",
+    signature: "v6-mldsa-87-sample-signature.asc",
+  },
+  {
+    name: "SLH-DSA-SHAKE-128f",
+    publicKey: "v6-slhdsa-128f-sample-pk.asc",
+    signature: "v6-slhdsa-128f-sample-signature.asc",
+  },
+  {
+    name: "SLH-DSA-SHAKE-128s",
+    publicKey: "v6-slhdsa-128s-sample-pk.asc",
+    signature: "v6-slhdsa-128s-sample-signature.asc",
+  },
+  {
+    name: "SLH-DSA-SHAKE-256s",
+    publicKey: "v6-slhdsa-256s-sample-pk.asc",
+    signature: "v6-slhdsa-256s-sample-signature.asc",
+  },
+];
+
+add_setup(async function () {
+  do_get_profile();
+
+  await OpenPGPTestUtils.initOpenPGP();
+});
+
+add_task(async function testImportPqcPublicKey() {
+  Services.prefs.setBoolPref("mail.openpgp.pqc", true);
+
+  let fingerprint = null;
+  try {
+    const publicKey = await IOUtils.readUTF8(
+      do_get_file(`${pqcDataDir}/v6-mldsa-65-sample-pk.asc`).path
+    );
+    const result = await RNP.importPubkeyBlockAutoAcceptImpl(
+      null,
+      publicKey,
+      "unverified"
+    );
+    Assert.equal(result.exitCode, 0, "PQC public key imported");
+    Assert.equal(result.importedKeys.length, 1, "one PQC key imported");
+
+    const key = EnigmailKeyRing.getKeyById(result.importedKeys[0]);
+    Assert.ok(key, "imported PQC key is in the key ring");
+    fingerprint = key.fpr;
+    Assert.equal(key.version, 6, "imported key uses OpenPGP v6");
+    Assert.equal(fingerprint.length, 64, "imported key has a v6 fingerprint");
+    Assert.equal(
+      key.fprFormatted.replaceAll(" ", ""),
+      fingerprint,
+      "the complete v6 fingerprint is formatted"
+    );
+
+    const encryptResult = {};
+    await RNP.encryptAndOrSign(
+      data,
+      {
+        aliasKeys: new Map(),
+        armor: true,
+        bcc: [],
+        encrypt: true,
+        encryptToSender: false,
+        sender: "",
+        senderKeyIsExternal: false,
+        sigTypeClear: false,
+        sigTypeDetached: false,
+        sign: false,
+        signatureHash: "SHA256",
+        to: ["<pqc-test-key@example.com>"],
+      },
+      encryptResult
+    );
+    Assert.equal(encryptResult.exitCode, 0, "PQC encryption succeeded");
+  } finally {
+    if (fingerprint) {
+      await RNP.deleteKey(fingerprint, false);
+      EnigmailKeyRing.clearCache();
+    }
+    Services.prefs.clearUserPref("mail.openpgp.pqc");
+  }
+});
+
+add_task(async function testImportAndUsePqcSecretKey() {
+  Services.prefs.setBoolPref("mail.openpgp.pqc", true);
+
+  Assert.ok(
+    RNP.getSupportedFeatureFlags() & 8,
+    "SEIPDv2 is recognized as a supported key feature"
+  );
+
+  let keyId = null;
+  try {
+    const keyIds = await OpenPGPTestUtils.importPrivateKey(
+      null,
+      do_get_file(`${pqcDataDir}/v6-mldsa-65-sample-sk.asc`)
+    );
+    Assert.equal(keyIds.length, 1, "one PQC secret key imported");
+    [keyId] = keyIds;
+
+    const encrypted = await IOUtils.readUTF8(
+      do_get_file(`${pqcDataDir}/v6-mldsa-65-sample-message.asc`).path
+    );
+    const decryptResult = await RNP.decrypt(encrypted, {
+      fromAddr: "",
+      maxOutputLength: encrypted.length * 100,
+      msgDate: null,
+      noOutput: false,
+      uiFlags: EnigmailConstants.UI_PGP_MIME,
+      verifyOnly: false,
+    });
+    Assert.equal(decryptResult.exitCode, 0, "PQC decryption succeeded");
+    Assert.equal(decryptResult.decryptedData, data, "PQC decrypted plaintext matches");
+    Assert.notEqual(
+      decryptResult.encToDetails.myRecipKey.keyId,
+      "0000000000000000",
+      "PQC decryption reports the recipient key ID"
+    );
+
+    const signResult = {};
+    const signature = await RNP.encryptAndOrSign(
+      data,
+      {
+        aliasKeys: new Map(),
+        armor: true,
+        bcc: [],
+        encrypt: false,
+        encryptToSender: false,
+        sender: keyId,
+        senderKeyIsExternal: false,
+        sigTypeClear: false,
+        sigTypeDetached: true,
+        sign: true,
+        signatureHash: "SHA256",
+        to: [],
+      },
+      signResult
+    );
+    Assert.equal(signResult.exitCode, 0, "PQC signing succeeded");
+
+    const verifyResult = await RNP.verifyDetached(
+      data,
+      signature,
+      "pqc-test-key@example.com",
+      null
+    );
+    Assert.equal(verifyResult.exitCode, 0, "PQC signature verified");
+    Assert.equal(
+      verifyResult.keyId,
+      keyId.replace(/^0x/, ""),
+      "PQC signature reports the signer key ID"
+    );
+  } finally {
+    if (keyId) {
+      await OpenPGPTestUtils.removeKeyById(keyId, true);
+    }
+    Services.prefs.clearUserPref("mail.openpgp.pqc");
+  }
+});
+
+add_task(function testV6FingerprintKeyserverUrl() {
+  const fingerprint = "A".repeat(64);
+  Assert.equal(
+    EnigmailKeyServer.serverReqURL(
+      `0x${fingerprint}`,
+      "vks://keys.openpgp.org"
+    ),
+    `https://keys.openpgp.org/vks/v1/by-fingerprint/${fingerprint}`,
+    "v6 fingerprints use the VKS fingerprint endpoint"
+  );
+});
+
+add_task(async function testVerifyPqcSignatures() {
+  for (const vector of vectors) {
+    const publicKey = await IOUtils.readUTF8(
+      do_get_file(`${pqcDataDir}/${vector.publicKey}`).path
+    );
+    Assert.equal(
+      RNP.importToFFI(undefined, publicKey, true, false),
+      0,
+      `${vector.name}: public key imported`
+    );
+
+    const signature = await IOUtils.readUTF8(
+      do_get_file(`${pqcDataDir}/${vector.signature}`).path
+    );
+    const result = await RNP.verifyDetached(
+      data,
+      signature,
+      "pqc@example.test",
+      null
+    );
+    Assert.equal(result.exitCode, 0, `${vector.name}: signature verified`);
+  }
+});
+
+add_task(async function testGenerateAndUsePqcKey() {
+  Services.prefs.setBoolPref("mail.openpgp.pqc", true);
+
+  let fingerprint = null;
+  try {
+    const keyId = await RNP.genKey(
+      "PQC Generated <pqc-generated@example.test>",
+      "PQC",
+      0,
+      0,
+      await OpenPGPMasterpass.retrieveOpenPGPPassword()
+    );
+    Assert.ok(keyId, "PQC key generated");
+
+    await RNP.saveKeyRings();
+    EnigmailKeyRing.clearCache();
+
+    const key = EnigmailKeyRing.getKeyById(keyId);
+    Assert.ok(key, "generated PQC key is in the key ring");
+    fingerprint = key.fpr;
+    Assert.equal(key.version, 6, "generated key uses OpenPGP v6");
+    Assert.equal(fingerprint.length, 64, "generated key has a v6 fingerprint");
+    Assert.ok(
+      key.algoSym.startsWith("ML-DSA-65"),
+      "generated key uses ML-DSA-65"
+    );
+    Assert.equal(key.subKeys.length, 1, "generated key has one subkey");
+    Assert.ok(
+      key.subKeys[0].algoSym.startsWith("ML-KEM-768"),
+      "generated subkey uses ML-KEM-768"
+    );
+
+    const encryptResult = {};
+    const encrypted = await RNP.encryptAndOrSign(
+      data,
+      {
+        aliasKeys: new Map(),
+        armor: true,
+        bcc: [],
+        encrypt: true,
+        encryptToSender: false,
+        sender: "",
+        senderKeyIsExternal: false,
+        sigTypeClear: false,
+        sigTypeDetached: false,
+        sign: false,
+        signatureHash: "SHA256",
+        to: ["<pqc-generated@example.test>"],
+      },
+      encryptResult
+    );
+    Assert.equal(encryptResult.exitCode, 0, "PQC encryption succeeded");
+
+    const { exitCode, decryptedData } = await RNP.decrypt(encrypted, {
+      fromAddr: "",
+      maxOutputLength: encrypted.length * 100,
+      msgDate: null,
+      noOutput: false,
+      uiFlags: EnigmailConstants.UI_PGP_MIME,
+      verifyOnly: false,
+    });
+    Assert.equal(exitCode, 0, "PQC decryption succeeded");
+    Assert.equal(decryptedData, data, "PQC decrypted plaintext matches");
+  } finally {
+    if (fingerprint) {
+      await RNP.deleteKey(fingerprint, true);
+      EnigmailKeyRing.clearCache();
+    }
+    Services.prefs.clearUserPref("mail.openpgp.pqc");
+  }
+});
