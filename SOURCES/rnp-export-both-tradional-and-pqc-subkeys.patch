+                }
+                continue;
+            }
+#endif
+            if (!sub || cur->creation() > sub->creation()) {
+                sub = cur;
+            }
+        }
+        if (!sub && !pqc_sub) {
+            FFI_LOG(key->ffi, "No encrypting subkey");
+            return RNP_ERROR_KEY_NOT_FOUND;
+        }
+        /* If only a PQC subkey is available, export it as the sole subkey. */
+        if (!sub) {
+            sub = pqc_sub;
+            pqc_sub = nullptr;
+        }
