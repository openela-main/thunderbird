+#include "config.h"
 #include "hash.hpp"
 #include "s2k.h"
 #include "mem.h"
 #include "logging.h"
 
+/* Argon2 KDFs are available since OpenSSL 3.2 */
+#if defined(ENABLE_CRYPTO_REFRESH) && OPENSSL_VERSION_NUMBER >= 0x30200000L
+#include <openssl/kdf.h>
+#include <openssl/params.h>
+#include <openssl/core_names.h>
