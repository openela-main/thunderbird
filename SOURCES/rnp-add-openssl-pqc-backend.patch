+exdsa_private_key_t::exdsa_private_key_t(uint8_t *   key_buf,
+                                         size_t      key_buf_len,
+                                         pgp_curve_t curve)
+    : ec_key_t(curve), key_(key_buf, key_buf + key_buf_len)
